<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Nuestro Rincón — Rubén &amp; Mar</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
          colors: {
            cream: '#FAF6F0',
            linen: '#F3ECE2',
            parchment: '#E8DDD0',
            ink: '#2D241E',
            muted: '#75665A',
            terracotta: '#C46D52',
            terracottaDark: '#A3533B',
            roseDust: '#D89A8E',
            sage: '#7A8E7A',
          },
          boxShadow: {
            editorial: '0 10px 30px -10px rgba(45, 36, 30, 0.08)',
            card: '0 4px 18px -4px rgba(45, 36, 30, 0.06)',
          },
        },
      },
    };
  </script>
  <style>
    body {
      background-color: #FAF6F0;
      color: #2D241E;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background-image:
        radial-gradient(circle at 12% 10%, rgba(196, 109, 82, 0.08), transparent 42%),
        radial-gradient(circle at 88% 18%, rgba(216, 154, 142, 0.12), transparent 45%),
        radial-gradient(circle at 50% 95%, rgba(122, 142, 122, 0.07), transparent 50%);
      min-height: 100vh;
    }
    .font-editorial {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-up {
      animation: fadeSlideUp 0.28s ease-out forwards;
    }
  </style>
</head>
<body class="antialiased selection:bg-terracotta/20 selection:text-ink">

  <!-- PANTALLA DE ACCESO PRIVADO -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-white/95 backdrop-blur-sm border border-parchment rounded-3xl p-6 sm:p-8 shadow-editorial animate-fade-up">
      <div class="text-center mb-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-linen border border-parchment text-xs font-medium text-muted mb-4">
          <span>✦</span>
          <span>Espacio privado · Rubén &amp; Mar</span>
        </div>
        <h1 class="font-editorial text-4xl sm:text-[42px] font-semibold tracking-tight text-ink leading-none">
          Nuestro Rincón
        </h1>
        <p class="text-sm text-muted mt-2.5 leading-relaxed">
          Inicia sesión con tu usuario para entrar a vuestro espacio compartido.
        </p>
      </div>

      <form id="loginForm" onsubmit="return handleLoginSubmit(event)" class="space-y-4">
        <div>
          <label for="loginUsername" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">
            Usuario
          </label>
          <input
            id="loginUsername"
            name="username"
            type="text"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            placeholder="Escribe tu usuario"
            class="w-full h-11 rounded-2xl border border-parchment bg-cream/70 px-4 text-sm text-ink placeholder:text-muted/60 focus:outline-none focus:border-terracotta focus:bg-white transition"
          />
        </div>

        <div>
          <label for="loginPassword" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">
            Contraseña
          </label>
          <input
            id="loginPassword"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Escribe tu contraseña"
            class="w-full h-11 rounded-2xl border border-parchment bg-cream/70 px-4 text-sm text-ink placeholder:text-muted/60 focus:outline-none focus:border-terracotta focus:bg-white transition"
          />
        </div>

        <label class="flex items-center gap-2.5 pt-1 cursor-pointer select-none">
          <input
            id="rememberSession"
            type="checkbox"
            checked
            class="w-4 h-4 rounded border-parchment text-terracotta focus:ring-terracotta accent-[#C46D52]"
          />
          <span class="text-xs text-muted">Mantener la sesión iniciada en este dispositivo</span>
        </label>

        <div id="loginError" class="hidden rounded-2xl bg-terracotta/10 border border-terracotta/30 px-4 py-2.5 text-xs font-medium text-terracottaDark">
          Usuario o contraseña incorrectos. Revísalos e inténtalo de nuevo.
        </div>

        <button
          id="loginSubmitBtn"
          type="button"
          onclick="attemptLogin()"
          class="w-full h-11 mt-2 rounded-2xl bg-terracotta hover:bg-terracottaDark active:scale-[0.99] text-white font-semibold text-sm shadow-card transition cursor-pointer"
        >
          Entrar a Nuestro Rincón
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-parchment/80 flex items-center justify-between text-[11px] text-muted">
        <span>Desde el 28 de febrero de 2025</span>
        <span>Privado · Solo dos</span>
      </div>
    </div>
  </div>

  <!-- APLICACIÓN PRINCIPAL -->
  <div id="appShell" class="hidden min-h-screen flex flex-col">
    <!-- CABECERA SUPERIOR -->
    <header class="sticky top-0 z-30 bg-cream/90 backdrop-blur-md border-b border-parchment/90">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-2xl bg-terracotta/12 border border-terracotta/25 flex items-center justify-center text-terracotta font-editorial text-xl font-bold shrink-0">
            ♥
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-editorial text-2xl font-semibold text-ink leading-none truncate">Nuestro Rincón</span>
              <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-linen border border-parchment text-muted">
                Rubén &amp; Mar
              </span>
            </div>
            <p id="activeUserBanner" class="text-xs text-muted mt-0.5 truncate">
              Sesión iniciada
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            onclick="exportDataBackup()"
            title="Descargar copia de seguridad JSON"
            class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3.5 rounded-xl border border-parchment bg-white hover:bg-linen text-xs font-medium text-ink transition cursor-pointer"
          >
            <span>Respaldo</span>
          </button>
          <button
            type="button"
            onclick="logoutUser()"
            class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-xl border border-parchment bg-white hover:bg-terracotta/10 hover:border-terracotta/40 text-xs font-semibold text-ink transition cursor-pointer"
          >
            <span>Salir</span>
          </button>
        </div>
      </div>

      <!-- NAVEGACIÓN DE PESTAÑAS -->
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 pb-3">
        <div id="tabsBar" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
          <button type="button" data-tab="inicio" onclick="switchTab('inicio')" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            Inicio
          </button>
          <button type="button" data-tab="calendario" onclick="switchTab('calendario')" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            Calendario
          </button>
          <button type="button" data-tab="notas" onclick="switchTab('notas')" class="tab-btn shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            <span>Notas</span>
            <span id="unreadBadge" class="hidden px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-terracotta text-white leading-none">0</span>
          </button>
          <button type="button" data-tab="planes" onclick="switchTab('planes')" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            Planes
          </button>
          <button type="button" data-tab="galeria" onclick="switchTab('galeria')" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            Galería
          </button>
          <button type="button" data-tab="gustos" onclick="switchTab('gustos')" class="tab-btn shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer">
            Gustos
          </button>
        </div>
      </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

      <!-- PESTAÑA 1: INICIO -->
      <section id="tab-inicio" class="tab-panel space-y-6 animate-fade-up">
        <div class="bg-white border border-parchment rounded-3xl p-6 sm:p-8 shadow-editorial">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-6 border-b border-parchment/80">
            <div>
              <p class="text-xs uppercase tracking-widest font-semibold text-terracotta">Contador desde nuestro comienzo</p>
              <h2 class="font-editorial text-3xl sm:text-4xl font-semibold text-ink mt-1">
                28 de febrero de 2025 · 12:00
              </h2>
            </div>
            <p id="welcomePersonalLine" class="text-sm text-muted"></p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-6">
            <div class="h-full rounded-2xl bg-cream border border-parchment p-4 sm:p-5 text-center flex flex-col justify-center">
              <span id="cdDays" class="font-editorial text-4xl sm:text-5xl font-bold text-ink leading-none">0</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-muted mt-2">Días</span>
            </div>
            <div class="h-full rounded-2xl bg-cream border border-parchment p-4 sm:p-5 text-center flex flex-col justify-center">
              <span id="cdHours" class="font-editorial text-4xl sm:text-5xl font-bold text-ink leading-none">00</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-muted mt-2">Horas</span>
            </div>
            <div class="h-full rounded-2xl bg-cream border border-parchment p-4 sm:p-5 text-center flex flex-col justify-center">
              <span id="cdMinutes" class="font-editorial text-4xl sm:text-5xl font-bold text-ink leading-none">00</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-muted mt-2">Minutos</span>
            </div>
            <div class="h-full rounded-2xl bg-cream border border-parchment p-4 sm:p-5 text-center flex flex-col justify-center">
              <span id="cdSeconds" class="font-editorial text-4xl sm:text-5xl font-bold text-terracotta leading-none">00</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-muted mt-2">Segundos</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 items-stretch">
          <div class="h-full bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card flex flex-col justify-between min-w-0">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">Buzón</span>
              <h3 class="font-editorial text-2xl font-semibold text-ink mt-1">Última nota recibida</h3>
              <p id="homeLatestNoteTitle" class="text-sm font-semibold text-ink mt-3 break-words">—</p>
              <p id="homeLatestNotePreview" class="text-xs text-muted mt-1.5 line-clamp-3 break-words">—</p>
            </div>
            <button type="button" onclick="switchTab('notas')" class="mt-4 text-left text-xs font-semibold text-terracotta hover:text-terracottaDark cursor-pointer">
              Abrir buzón de notas →
            </button>
          </div>

          <div class="h-full bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card flex flex-col justify-between min-w-0">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-sage">Próximo plan</span>
              <h3 class="font-editorial text-2xl font-semibold text-ink mt-1">Por cumplir juntos</h3>
              <p id="homeNextPlanTitle" class="text-sm font-semibold text-ink mt-3 break-words">—</p>
              <p id="homeNextPlanMeta" class="text-xs text-muted mt-1.5 break-words">—</p>
            </div>
            <button type="button" onclick="switchTab('planes')" class="mt-4 text-left text-xs font-semibold text-terracotta hover:text-terracottaDark cursor-pointer">
              Ver lista de planes →
            </button>
          </div>

          <div class="h-full bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card flex flex-col justify-between min-w-0">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-roseDust">Recuerdos</span>
              <h3 class="font-editorial text-2xl font-semibold text-ink mt-1">Álbum y fechas</h3>
              <p id="homeGallerySummary" class="text-sm font-semibold text-ink mt-3 break-words">—</p>
              <p id="homeCalendarSummary" class="text-xs text-muted mt-1.5 break-words">—</p>
            </div>
            <button type="button" onclick="switchTab('galeria')" class="mt-4 text-left text-xs font-semibold text-terracotta hover:text-terracottaDark cursor-pointer">
              Explorar galería →
            </button>
          </div>
        </div>
      </section>

      <!-- PESTAÑA 2: CALENDARIO -->
      <section id="tab-calendario" class="tab-panel hidden space-y-6 animate-fade-up">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-7 bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card">
            <div class="flex items-center justify-between gap-2 mb-5">
              <button type="button" onclick="changeMonth(-1)" class="w-9 h-9 rounded-xl border border-parchment bg-cream hover:bg-linen flex items-center justify-center text-sm font-semibold cursor-pointer">
                ‹
              </button>
              <h2 id="calendarMonthTitle" class="font-editorial text-2xl sm:text-3xl font-semibold text-ink capitalize"></h2>
              <button type="button" onclick="changeMonth(1)" class="w-9 h-9 rounded-xl border border-parchment bg-cream hover:bg-linen flex items-center justify-center text-sm font-semibold cursor-pointer">
                ›
              </button>
            </div>

            <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-bold uppercase tracking-wider text-muted mb-2">
              <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
            </div>
            <div id="calendarGrid" class="grid grid-cols-7 gap-1.5"></div>
          </div>

          <div class="lg:col-span-5 bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card space-y-4">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">Día seleccionado</span>
              <h3 id="selectedDateLabel" class="font-editorial text-2xl font-semibold text-ink mt-0.5"></h3>
            </div>

            <div id="selectedDateEvents" class="space-y-2.5"></div>

            <form onsubmit="addCalendarEvent(event)" class="pt-3 border-t border-parchment space-y-3">
              <p class="text-xs font-bold uppercase tracking-wider text-muted">Añadir fecha o cita</p>
              <input
                id="eventTitleInput"
                type="text"
                required
                placeholder="Ej. Cena especial, aniversario, escapada..."
                class="w-full h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
              />
              <input
                id="eventNoteInput"
                type="text"
                placeholder="Detalle opcional"
                class="w-full h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
              />
              <button type="submit" class="w-full h-10 rounded-xl bg-terracotta hover:bg-terracottaDark text-white text-xs font-semibold transition cursor-pointer">
                Guardar en el calendario
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- PESTAÑA 3: NOTAS (ESTILO GMAIL) -->
      <section id="tab-notas" class="tab-panel hidden space-y-6 animate-fade-up">
        <div class="bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-parchment">
            <div>
              <h2 class="font-editorial text-3xl font-semibold text-ink">Buzón de Notas</h2>
              <p class="text-xs text-muted mt-0.5">Mensajes privados entre Rubén y Mar</p>
            </div>
            <button
              type="button"
              onclick="toggleComposeModal(true)"
              class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-terracotta hover:bg-terracottaDark text-white text-xs font-semibold shadow-card transition cursor-pointer shrink-0"
            >
              <span>+ Redactar nota</span>
            </button>
          </div>

          <div class="flex flex-wrap items-center gap-2 mt-4">
            <button type="button" data-mail-folder="inbox" onclick="setMailFolder('inbox')" class="mail-folder-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer">
              Recibidos
            </button>
            <button type="button" data-mail-folder="sent" onclick="setMailFolder('sent')" class="mail-folder-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer">
              Enviados
            </button>
            <button type="button" data-mail-folder="favorites" onclick="setMailFolder('favorites')" class="mail-folder-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer">
              Favoritos
            </button>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 mt-5 items-start">
            <div id="mailListContainer" class="lg:col-span-5 space-y-2.5 min-w-0"></div>
            <div id="mailReaderContainer" class="lg:col-span-7 bg-cream/70 border border-parchment rounded-2xl p-5 sm:p-6 min-h-[260px] min-w-0"></div>
          </div>
        </div>
      </section>

      <!-- PESTAÑA 4: PLANES -->
      <section id="tab-planes" class="tab-panel hidden space-y-6 animate-fade-up">
        <div class="bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-parchment">
            <div>
              <h2 class="font-editorial text-3xl font-semibold text-ink">Nuestros Planes</h2>
              <p class="text-xs text-muted mt-0.5">Cosas que queremos hacer juntos y recuerdos ya cumplidos</p>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" data-plan-filter="pending" onclick="setPlanFilter('pending')" class="plan-filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer">
                Pendientes
              </button>
              <button type="button" data-plan-filter="done" onclick="setPlanFilter('done')" class="plan-filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer">
                Cumplidos
              </button>
            </div>
          </div>

          <form onsubmit="addPlanItem(event)" class="grid grid-cols-1 sm:grid-cols-12 gap-3 mt-5">
            <input
              id="planTitleInput"
              type="text"
              required
              placeholder="Nuevo plan juntos..."
              class="sm:col-span-6 h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
            />
            <input
              id="planCategoryInput"
              type="text"
              placeholder="Categoría (ej. Viaje, Cena, Hogar)"
              class="sm:col-span-4 h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
            />
            <button type="submit" class="sm:col-span-2 h-10 rounded-xl bg-terracotta hover:bg-terracottaDark text-white text-xs font-semibold transition cursor-pointer">
              Añadir
            </button>
          </form>

          <div id="plansList" class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-5"></div>
        </div>
      </section>

      <!-- PESTAÑA 5: GALERÍA -->
      <section id="tab-galeria" class="tab-panel hidden space-y-6 animate-fade-up">
        <div class="bg-white border border-parchment rounded-3xl p-5 sm:p-6 shadow-card">
          <div class="pb-5 border-b border-parchment">
            <h2 class="font-editorial text-3xl font-semibold text-ink">Galería de Recuerdos</h2>
            <p class="text-xs text-muted mt-0.5">Sube una foto desde tu dispositivo o pega el enlace de una imagen</p>
          </div>

          <form onsubmit="addPhotoItem(event)" class="grid grid-cols-1 sm:grid-cols-12 gap-3 mt-5">
            <input
              id="photoCaptionInput"
              type="text"
              required
              placeholder="Título o momento de la foto..."
              class="sm:col-span-4 h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
            />
            <input
              id="photoUrlInput"
              type="text"
              placeholder="URL de imagen (opcional si subes archivo)"
              class="sm:col-span-4 h-10 rounded-xl border border-parchment bg-cream/70 px-3.5 text-sm text-ink focus:outline-none focus:border-terracotta"
            />
            <label class="sm:col-span-2 h-10 rounded-xl border border-parchment bg-cream hover:bg-linen px-3 flex items-center justify-center text-xs font-semibold text-ink cursor-pointer truncate">
              <span id="photoFileLabel">Elegir foto</span>
              <input id="photoFileInput" type="file" accept="image/*" onchange="handlePhotoFileChange(event)" class="hidden" />
            </label>
            <button type="submit" class="sm:col-span-2 h-10 rounded-xl bg-terracotta hover:bg-terracottaDark text-white text-xs font-semibold transition cursor-pointer">
              Guardar
            </button>
          </form>

          <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6"></div>
        </div>
      </section>

      <!-- PESTAÑA 6: GUSTOS Y DETALLES -->
