  <script>
    const STORAGE_KEY = 'nuestro_rincon_ruben_mar_v1';
    const SESSION_KEY = 'nuestro_rincon_session_v1';
    const ANNIVERSARY_DATE = new Date('2025-02-28T12:00:00');

    const USERS = {
      rmozos: {
        username: 'rmozos',
        password: ['05092003'],
        displayName: 'Rubén',
        partnerName: 'Mar',
      },
      mdiaz: {
        username: 'mdiaz',
        password: ['05092005'],
        displayName: 'Mar',
        partnerName: 'Rubén',
      },
    };

    function createDefaultState() {
      return {
        notes: [
          {
            id: 'welcome-mar-christmas',
            from: 'Rubén',
            to: 'Mar',
            subject: 'Para ti, mi amor ❤️',
            tag: 'Bienvenida',
            body: 'Hola mi amor, esto lo llevo haciendo varios días y quería que fuera para una parte de tu regalo de navidad, pero no he podido aguantar las ganas de enseñártelo y poder disfrutar los dos de esta app.\nTe quiero mucho mi amor.',
            createdAt: '2025-12-20T18:00:00.000Z',
            readByRecipient: false,
            favorite: true,
          },
        ],
        events: [
          {
            id: 'evt-anniversary-2025',
            date: '2025-02-28',
            title: 'Nuestro comienzo',
            note: '28 de febrero de 2025 a las 12:00',
            author: 'Rubén',
          },
        ],
        plans: [
          {
            id: 'plan-1',
            title: 'Escapada de fin de semana juntos',
            category: 'Viaje',
            done: false,
            author: 'Rubén',
          },
          {
            id: 'plan-2',
            title: 'Noche de película y cena casera',
            category: 'En casa',
            done: false,
            author: 'Mar',
          },
        ],
        photos: [],
        tastes: {
          Rubén: [
            { id: 'r-1', label: 'Comida favorita', value: '' },
            { id: 'r-2', label: 'Plan ideal', value: '' },
            { id: 'r-3', label: 'Café o bebida', value: '' },
            { id: 'r-4', label: 'Color o estilo', value: '' },
            { id: 'r-5', label: 'Canción o película', value: '' },
            { id: 'r-6', label: 'Pequeño detalle que le alegra', value: '' },
          ],
          Mar: [
            { id: 'm-1', label: 'Comida favorita', value: '' },
            { id: 'm-2', label: 'Plan ideal', value: '' },
            { id: 'm-3', label: 'Dulce o bebida', value: '' },
            { id: 'm-4', label: 'Color o estilo', value: '' },
            { id: 'm-5', label: 'Canción o película', value: '' },
            { id: 'm-6', label: 'Pequeño detalle que le alegra', value: '' },
          ],
        },
      };
    }

    let appState = loadAppState();
    let currentSession = null;
    let activeTab = 'inicio';
    let mailFolder = 'inbox';
    let selectedNoteId = null;
    let planFilter = 'pending';
    let tastePerson = 'Rubén';
    let editingTasteId = null;
    let uploadedPhotoDataUrl = '';
    let calYear = new Date().getFullYear();
    let calMonth = new Date().getMonth();
    let selectedDateStr = formatDateKey(new Date());

    function loadAppState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return createDefaultState();
        const parsed = JSON.parse(raw);
        const def = createDefaultState();
        return {
          notes: Array.isArray(parsed.notes) ? parsed.notes : def.notes,
          events: Array.isArray(parsed.events) ? parsed.events : def.events,
          plans: Array.isArray(parsed.plans) ? parsed.plans : def.plans,
          photos: Array.isArray(parsed.photos) ? parsed.photos : def.photos,
          tastes: {
            Rubén: Array.isArray(parsed.tastes?.Rubén) ? parsed.tastes.Rubén : def.tastes.Rubén,
            Mar: Array.isArray(parsed.tastes?.Mar) ? parsed.tastes.Mar : def.tastes.Mar,
          },
        };
      } catch (e) {
        return createDefaultState();
      }
    }

    function saveAppState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {}
      renderHomeSummary();
      updateUnreadBadge();
    }

    function handleLoginSubmit(event) {
      if (event) event.preventDefault();
      attemptLogin();
      return false;
    }

    function attemptLogin() {
      const userInput = document.getElementById('loginUsername');
      const passInput = document.getElementById('loginPassword');
      const rememberInput = document.getElementById('rememberSession');
      const errorBox = document.getElementById('loginError');

      const rawUser = (userInput ? userInput.value : '').trim().toLowerCase();
      const rawPass = (passInput ? passInput.value : '').trim();

      const matched = USERS[rawUser];
      const validPass = matched && matched.password.includes(rawPass);

      if (!matched || !validPass) {
        if (errorBox) errorBox.classList.remove('hidden');
        return;
      }

      if (errorBox) errorBox.classList.add('hidden');
      const sessionData = {
        username: matched.username,
        displayName: matched.displayName,
        partnerName: matched.partnerName,
      };

      currentSession = sessionData;
      if (rememberInput && rememberInput.checked) {
        try { localStorage.setItem(SESSION_KEY, JSON.stringify(sessionData)); } catch (e) {}
      } else {
        try { sessionStorage.setItem(SESSION_KEY, JSON.stringify(sessionData)); } catch (e) {}
      }

      enterApp();
    }

    function logoutUser() {
      currentSession = null;
      try {
        localStorage.removeItem(SESSION_KEY);
        sessionStorage.removeItem(SESSION_KEY);
      } catch (e) {}

      const passInput = document.getElementById('loginPassword');
      if (passInput) passInput.value = '';
      document.getElementById('appShell').classList.add('hidden');
      document.getElementById('loginScreen').classList.remove('hidden');
    }

    function enterApp() {
      if (!currentSession) return;
      document.getElementById('loginScreen').classList.add('hidden');
      document.getElementById('appShell').classList.remove('hidden');

      document.getElementById('activeUserBanner').textContent =
        `Hola, ${currentSession.displayName} · Compartido con ${currentSession.partnerName}`;
      document.getElementById('welcomePersonalLine').textContent =
        `Conectado como ${currentSession.displayName}`;

      tastePerson = currentSession.displayName;
      switchTab(activeTab || 'inicio');
      updateCountdown();
      renderHomeSummary();
      renderCalendar();
      renderMailbox();
      renderPlans();
      renderGallery();
      renderTastes();
      updateUnreadBadge();
    }

    function switchTab(tabName) {
      activeTab = tabName;
      document.querySelectorAll('.tab-panel').forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== `tab-${tabName}`);
      });
      document.querySelectorAll('.tab-btn').forEach((btn) => {
        const isActive = btn.dataset.tab === tabName;
        btn.className = isActive
          ? 'tab-btn shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-terracotta text-white shadow-card transition cursor-pointer'
          : 'tab-btn shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-white/80 text-muted hover:text-ink hover:bg-white border border-parchment/80 transition cursor-pointer';
      });
    }

    function updateCountdown() {
      const now = new Date();
      const diff = Math.max(0, now.getTime() - ANNIVERSARY_DATE.getTime());
      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      const dEl = document.getElementById('cdDays');
      const hEl = document.getElementById('cdHours');
      const mEl = document.getElementById('cdMinutes');
      const sEl = document.getElementById('cdSeconds');

      if (dEl) dEl.textContent = String(days);
      if (hEl) hEl.textContent = String(hours).padStart(2, '0');
      if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
      if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
    }

    function renderHomeSummary() {
      const me = currentSession ? currentSession.displayName : 'Rubén';
      const received = appState.notes.filter((n) => n.to === me);
      const latestNote = received[0] || appState.notes[0];

      const titleEl = document.getElementById('homeLatestNoteTitle');
      const prevEl = document.getElementById('homeLatestNotePreview');
      if (latestNote) {
        titleEl.textContent = `${latestNote.subject || 'Sin asunto'} · De ${latestNote.from}`;
        prevEl.textContent = latestNote.body;
      } else {
        titleEl.textContent = 'Sin notas todavía';
        prevEl.textContent = 'Escribe la primera nota en el buzón.';
      }

      const nextPlan = appState.plans.find((p) => !p.done);
      const planTitleEl = document.getElementById('homeNextPlanTitle');
      const planMetaEl = document.getElementById('homeNextPlanMeta');
      if (nextPlan) {
        planTitleEl.textContent = nextPlan.title;
        planMetaEl.textContent = `${nextPlan.category || 'Plan'} · Propuesto por ${nextPlan.author}`;
      } else {
        planTitleEl.textContent = '¡Todos los planes cumplidos!';
        planMetaEl.textContent = 'Añade uno nuevo cuando queráis.';
      }

      document.getElementById('homeGallerySummary').textContent =
        `${appState.photos.length} ${appState.photos.length === 1 ? 'foto guardada' : 'fotos guardadas'}`;
      document.getElementById('homeCalendarSummary').textContent =
        `${appState.events.length} ${appState.events.length === 1 ? 'fecha marcada' : 'fechas marcadas'} en el calendario`;
    }

    function formatDateKey(dateObj) {
      const y = dateObj.getFullYear();
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const d = String(dateObj.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function changeMonth(delta) {
      calMonth += delta;
      if (calMonth < 0) {
        calMonth = 11;
        calYear -= 1;
      } else if (calMonth > 11) {
        calMonth = 0;
        calYear += 1;
      }
      renderCalendar();
    }

    function renderCalendar() {
      const titleEl = document.getElementById('calendarMonthTitle');
      const gridEl = document.getElementById('calendarGrid');
      const firstDay = new Date(calYear, calMonth, 1);
      titleEl.textContent = firstDay.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });

      const startWeekday = (firstDay.getDay() + 6) % 7;
      const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
      const todayKey = formatDateKey(new Date());

      let html = '';
      for (let i = 0; i < startWeekday; i++) {
        html += `<div class="h-10 rounded-xl bg-transparent"></div>`;
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const key = `${calYear}-${String(calMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const hasEvents = appState.events.some((ev) => ev.date === key);
        const isSelected = key === selectedDateStr;
        const isToday = key === todayKey;

        let cls = 'h-10 rounded-xl text-xs font-medium flex flex-col items-center justify-center relative transition cursor-pointer ';
        if (isSelected) {
          cls += 'bg-terracotta text-white font-semibold shadow-card';
        } else if (isToday) {
          cls += 'bg-linen border border-terracotta/50 text-ink font-semibold';
        } else {
          cls += 'bg-cream/80 hover:bg-linen text-ink';
        }

        html += `
          <button type="button" onclick="selectCalendarDate('${key}')" class="${cls}">
            <span>${day}</span>
            ${hasEvents ? `<span class="w-1.5 h-1.5 rounded-full mt-0.5 ${isSelected ? 'bg-white' : 'bg-terracotta'}"></span>` : ''}
          </button>
        `;
      }

      gridEl.innerHTML = html;
      renderSelectedDateEvents();
    }

    function selectCalendarDate(key) {
      selectedDateStr = key;
      renderCalendar();
    }

    function renderSelectedDateEvents() {
      const labelEl = document.getElementById('selectedDateLabel');
      const listEl = document.getElementById('selectedDateEvents');
      const [y, m, d] = selectedDateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      labelEl.textContent = dt.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });

      const dayEvents = appState.events.filter((ev) => ev.date === selectedDateStr);
      if (!dayEvents.length) {
        listEl.innerHTML = `<p class="text-xs text-muted py-2">No hay eventos guardados para este día.</p>`;
        return;
      }

      listEl.innerHTML = dayEvents.map((ev) => `
        <div class="rounded-2xl bg-cream border border-parchment p-3.5 flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-ink break-words">${escapeHtml(ev.title)}</p>
            ${ev.note ? `<p class="text-xs text-muted mt-0.5 break-words">${escapeHtml(ev.note)}</p>` : ''}
            <p class="text-[11px] text-muted mt-1">Añadido por ${escapeHtml(ev.author || 'Rubén')}</p>
          </div>
          <button type="button" onclick="deleteCalendarEvent('${ev.id}')" class="text-xs text-muted hover:text-terracottaDark cursor-pointer shrink-0">
            Eliminar
          </button>
        </div>
      `).join('');
    }

    function addCalendarEvent(event) {
      event.preventDefault();
      const titleInput = document.getElementById('eventTitleInput');
      const noteInput = document.getElementById('eventNoteInput');
      const title = titleInput.value.trim();
      if (!title) return;

      appState.events.unshift({
        id: `evt-${Date.now()}`,
        date: selectedDateStr,
        title,
        note: noteInput.value.trim(),
        author: currentSession ? currentSession.displayName : 'Rubén',
      });

      titleInput.value = '';
      noteInput.value = '';
      saveAppState();
      renderCalendar();
    }

    function deleteCalendarEvent(id) {
      appState.events = appState.events.filter((ev) => ev.id !== id);
      saveAppState();
      renderCalendar();
    }

    function setMailFolder(folder) {
      mailFolder = folder;
      selectedNoteId = null;
      renderMailbox();
    }

    function getFilteredNotes() {
      const me = currentSession ? currentSession.displayName : 'Rubén';
      if (mailFolder === 'inbox') {
        return appState.notes.filter((n) => n.to === me);
      }
      if (mailFolder === 'sent') {
        return appState.notes.filter((n) => n.from === me);
      }
      return appState.notes.filter((n) => n.favorite && (n.to === me || n.from === me));
    }

    function updateUnreadBadge() {
      const badge = document.getElementById('unreadBadge');
      if (!badge || !currentSession) return;
      const unreadCount = appState.notes.filter(
        (n) => n.to === currentSession.displayName && !n.readByRecipient
      ).length;
      if (unreadCount > 0) {
        badge.textContent = String(unreadCount);
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function renderMailbox() {
      const me = currentSession ? currentSession.displayName : 'Rubén';
      document.querySelectorAll('.mail-folder-btn').forEach((btn) => {
        const active = btn.dataset.mailFolder === mailFolder;
        btn.className = active
          ? 'mail-folder-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-terracotta text-white transition cursor-pointer'
          : 'mail-folder-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-cream text-muted hover:text-ink border border-parchment transition cursor-pointer';
      });

      const list = getFilteredNotes();
      if (!selectedNoteId && list.length > 0) {
        selectedNoteId = list[0].id;
      }

      const listContainer = document.getElementById('mailListContainer');
      if (!list.length) {
        listContainer.innerHTML = `
          <div class="rounded-2xl border border-parchment bg-cream/60 p-6 text-center text-xs text-muted">
            No hay notas en esta bandeja.
          </div>
        `;
      } else {
        listContainer.innerHTML = list.map((note) => {
          const isSelected = note.id === selectedNoteId;
          const isUnreadForMe = note.to === me && !note.readByRecipient;
          const statusText = note.from === me
            ? (note.readByRecipient ? `Leído por ${note.to}` : `Pendiente de leer por ${note.to}`)
            : (note.readByRecipient ? 'Leído' : 'Nuevo');

          return `
            <button
              type="button"
              onclick="openNote('${note.id}')"
              class="w-full text-left rounded-2xl border p-4 transition cursor-pointer ${
                isSelected
                  ? 'bg-linen border-terracotta shadow-card'
                  : 'bg-cream/60 hover:bg-linen/80 border-parchment'
              }"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold text-ink truncate">
                  ${mailFolder === 'sent' ? `Para: ${escapeHtml(note.to)}` : `De: ${escapeHtml(note.from)}`}
                </span>
                <span class="text-[11px] font-semibold ${isUnreadForMe ? 'text-terracotta' : 'text-muted'}">
                  ${statusText}
                </span>
              </div>
              <p class="text-sm ${isUnreadForMe ? 'font-bold text-ink' : 'font-semibold text-ink/90'} mt-1 truncate">
                ${escapeHtml(note.subject || 'Sin asunto')}
              </p>
              <p class="text-xs text-muted mt-1 line-clamp-2 break-words">${escapeHtml(note.body)}</p>
            </button>
          `;
        }).join('');
      }

      renderNoteReader();
      updateUnreadBadge();
    }

    function openNote(id) {
      selectedNoteId = id;
      const me = currentSession ? currentSession.displayName : 'Rubén';
      const note = appState.notes.find((n) => n.id === id);
      if (note && note.to === me && !note.readByRecipient) {
        note.readByRecipient = true;
        saveAppState();
      }
      renderMailbox();
    }

    function renderNoteReader() {
      const reader = document.getElementById('mailReaderContainer');
      const note = appState.notes.find((n) => n.id === selectedNoteId);
      if (!note) {
        reader.innerHTML = `
          <div class="h-full flex items-center justify-center text-xs text-muted text-center">
            Selecciona una nota para leerla aquí.
          </div>
        `;
        return;
      }

      const dateFormatted = new Date(note.createdAt).toLocaleString('es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });

      reader.innerHTML = `
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-3 pb-3 border-b border-parchment">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-editorial text-2xl sm:text-3xl font-semibold text-ink break-words">
                  ${escapeHtml(note.subject || 'Sin asunto')}
                </h3>
                ${note.tag ? `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-terracotta/12 text-terracottaDark">${escapeHtml(note.tag)}</span>` : ''}
              </div>
              <p class="text-xs text-muted mt-1">
                De <strong>${escapeHtml(note.from)}</strong> para <strong>${escapeHtml(note.to)}</strong> · ${dateFormatted}
              </p>
            </div>
            <button
              type="button"
              onclick="toggleNoteFavorite('${note.id}')"
              class="px-3 py-1.5 rounded-xl border border-parchment bg-white text-xs font-semibold cursor-pointer shrink-0 ${
                note.favorite ? 'text-terracotta' : 'text-muted'
              }"
            >
              ${note.favorite ? '★ Favorita' : '☆ Favorita'}
            </button>
          </div>

          <div class="text-sm text-ink leading-relaxed whitespace-pre-line break-words py-1">${escapeHtml(note.body)}</div>

          <div class="pt-3 border-t border-parchment flex items-center justify-between gap-2">
            <button
              type="button"
              onclick="replyToNote('${escapeHtml(note.subject || 'Re: Tu nota')}')"
              class="h-9 px-4 rounded-xl bg-terracotta hover:bg-terracottaDark text-white text-xs font-semibold cursor-pointer"
            >
              Responder
            </button>
            <button
              type="button"
              onclick="deleteNote('${note.id}')"
              class="h-9 px-3.5 rounded-xl border border-parchment bg-white hover:bg-terracotta/10 text-xs font-semibold text-muted hover:text-terracottaDark cursor-pointer"
            >
              Eliminar
            </button>
          </div>
        </div>
      `;
    }

    function toggleNoteFavorite(id) {
      const note = appState.notes.find((n) => n.id === id);
      if (!note) return;
      note.favorite = !note.favorite;
      saveAppState();
      renderMailbox();
    }

    function deleteNote(id) {
      appState.notes = appState.notes.filter((n) => n.id !== id);
      if (selectedNoteId === id) selectedNoteId = null;
      saveAppState();
      renderMailbox();
    }

    function toggleComposeModal(open, defaultSubject = '') {
      const modal = document.getElementById('composeModal');
      if (!modal) return;
      if (open && currentSession) {
        document.getElementById('composeFromLabel').textContent = currentSession.displayName;
        document.getElementById('composeToLabel').textContent = currentSession.partnerName;
        document.getElementById('composeSubjectInput').value = defaultSubject;
        document.getElementById('composeTagInput').value = '';
        document.getElementById('composeBodyInput').value = '';
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    function replyToNote(subject) {
      const cleanSubject = subject.startsWith('Re:') ? subject : `Re: ${subject}`;
      toggleComposeModal(true, cleanSubject);
    }

    function sendNoteMessage(event) {
      event.preventDefault();
      if (!currentSession) return;
      const subject = document.getElementById('composeSubjectInput').value.trim();
      const tag = document.getElementById('composeTagInput').value.trim();
      const body = document.getElementById('composeBodyInput').value.trim();
      if (!body) return;

      const newNote = {
        id: `note-${Date.now()}`,
        from: currentSession.displayName,
        to: currentSession.partnerName,
        subject: subject || 'Una nota para ti',
        tag: tag || 'Cariño',
        body,
        createdAt: new Date().toISOString(),
        readByRecipient: false,
        favorite: false,
      };

      appState.notes.unshift(newNote);
      selectedNoteId = newNote.id;
      mailFolder = 'sent';
      saveAppState();
      toggleComposeModal(false);
      renderMailbox();
    }

    function setPlanFilter(filter) {
      planFilter = filter;
      renderPlans();
    }

    function addPlanItem(event) {
      event.preventDefault();
      const titleInput = document.getElementById('planTitleInput');
      const catInput = document.getElementById('planCategoryInput');
      const title = titleInput.value.trim();
      if (!title) return;

      appState.plans.unshift({
        id: `plan-${Date.now()}`,
        title,
        category: catInput.value.trim() || 'Juntos',
        done: false,
        author: currentSession ? currentSession.displayName : 'Rubén',
      });

      titleInput.value = '';
      catInput.value = '';
      planFilter = 'pending';
      saveAppState();
      renderPlans();
    }

    function togglePlanDone(id) {
      const plan = appState.plans.find((p) => p.id === id);
      if (!plan) return;
      plan.done = !plan.done;
      saveAppState();
      renderPlans();
    }

    function deletePlanItem(id) {
      appState.plans = appState.plans.filter((p) => p.id !== id);
      saveAppState();
      renderPlans();
    }

    function renderPlans() {
      document.querySelectorAll('.plan-filter-btn').forEach((btn) => {
        const active = btn.dataset.planFilter === planFilter;
        btn.className = active
          ? 'plan-filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-terracotta text-white transition cursor-pointer'
          : 'plan-filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-cream text-muted hover:text-ink border border-parchment transition cursor-pointer';
      });

      const filtered = appState.plans.filter((p) => (planFilter === 'done' ? p.done : !p.done));
      const container = document.getElementById('plansList');
      if (!filtered.length) {
        container.innerHTML = `
          <div class="col-span-full rounded-2xl border border-parchment bg-cream/60 p-6 text-center text-xs text-muted">
            No hay planes en este apartado.
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map((plan) => `
        <div class="h-full rounded-2xl border border-parchment bg-cream/70 p-4 flex items-start justify-between gap-3 min-w-0">
          <div class="flex items-start gap-3 min-w-0">
            <input
              type="checkbox"
              ${plan.done ? 'checked' : ''}
              onchange="togglePlanDone('${plan.id}')"
              class="mt-1 w-4 h-4 rounded border-parchment accent-[#C46D52] cursor-pointer shrink-0"
            />
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink break-words ${plan.done ? 'line-through text-muted' : ''}">
                ${escapeHtml(plan.title)}
              </p>
              <p class="text-[11px] text-muted mt-1">
                ${escapeHtml(plan.category)} · ${escapeHtml(plan.author)}
              </p>
            </div>
          </div>
          <button type="button" onclick="deletePlanItem('${plan.id}')" class="text-xs text-muted hover:text-terracottaDark cursor-pointer shrink-0">
            Borrar
          </button>
        </div>
      `).join('');
    }

    function handlePhotoFileChange(event) {
      const file = event.target.files && event.target.files[0];
      const label = document.getElementById('photoFileLabel');
      if (!file) {
        uploadedPhotoDataUrl = '';
        if (label) label.textContent = 'Elegir foto';
        return;
      }
      if (label) label.textContent = file.name;
      const reader = new FileReader();
      reader.onload = () => {
        uploadedPhotoDataUrl = String(reader.result || '');
      };
      reader.readAsDataURL(file);
    }

    function addPhotoItem(event) {
      event.preventDefault();
      const captionInput = document.getElementById('photoCaptionInput');
      const urlInput = document.getElementById('photoUrlInput');
      const caption = captionInput.value.trim();
      const src = uploadedPhotoDataUrl || urlInput.value.trim();
      if (!caption || !src) return;

      appState.photos.unshift({
        id: `photo-${Date.now()}`,
        caption,
        src,
        author: currentSession ? currentSession.displayName : 'Rubén',
      });

      captionInput.value = '';
      urlInput.value = '';
      uploadedPhotoDataUrl = '';
      const fileInput = document.getElementById('photoFileInput');
      if (fileInput) fileInput.value = '';
      const fileLabel = document.getElementById('photoFileLabel');
      if (fileLabel) fileLabel.textContent = 'Elegir foto';

      saveAppState();
      renderGallery();
    }

    function deletePhotoItem(id) {
      appState.photos = appState.photos.filter((p) => p.id !== id);
      saveAppState();
      renderGallery();
    }

    function renderGallery() {
      const grid = document.getElementById('galleryGrid');
      if (!appState.photos.length) {
        grid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-parchment bg-cream/60 p-8 text-center text-xs text-muted">
            Todavía no habéis subido ninguna foto. Añadid vuestro primer recuerdo arriba.
          </div>
        `;
        return;
      }

      grid.innerHTML = appState.photos.map((photo) => `
        <div class="h-full rounded-2xl border border-parchment bg-cream/70 overflow-hidden flex flex-col justify-between min-w-0">
          <div class="aspect-[4/3] w-full bg-linen overflow-hidden">
            <img src="${escapeAttr(photo.src)}" alt="${escapeAttr(photo.caption)}" class="w-full h-full object-cover" />
          </div>
          <div class="p-3.5 flex items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink break-words">${escapeHtml(photo.caption)}</p>
              <p class="text-[11px] text-muted mt-0.5">Subido por ${escapeHtml(photo.author)}</p>
            </div>
            <button type="button" onclick="deletePhotoItem('${photo.id}')" class="text-xs text-muted hover:text-terracottaDark cursor-pointer shrink-0">
              Quitar
            </button>
          </div>
        </div>
      `).join('');
    }

    function setTastePerson(person) {
      tastePerson = person;
      renderTastes();
    }

    function renderTastes() {
      document.querySelectorAll('.taste-person-btn').forEach((btn) => {
        const active = btn.dataset.tastePerson === tastePerson;
        btn.className = active
          ? 'taste-person-btn px-4 py-2 rounded-xl text-xs font-semibold bg-terracotta text-white transition cursor-pointer'
          : 'taste-person-btn px-4 py-2 rounded-xl text-xs font-semibold bg-cream text-muted hover:text-ink border border-parchment transition cursor-pointer';
      });

      const items = appState.tastes[tastePerson] || [];
      const grid = document.getElementById('tastesGrid');
      grid.innerHTML = items.map((item) => `
        <button
          type="button"
          onclick="openTasteModal('${item.id}')"
          class="h-full w-full text-left rounded-2xl border border-parchment bg-cream/70 hover:bg-linen p-4 transition cursor-pointer flex flex-col justify-between min-w-0"
        >
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">${escapeHtml(item.label)}</span>
            <p class="text-sm text-ink mt-2 whitespace-pre-line break-words">
              ${item.value ? escapeHtml(item.value) : '<span class="text-muted italic">Toca para añadir detalle...</span>'}
            </p>
          </div>
          <span class="text-[11px] text-muted mt-4">Editar · ${escapeHtml(tastePerson)}</span>
        </button>
      `).join('');
    }

    function openTasteModal(id) {
      const items = appState.tastes[tastePerson] || [];
      const item = items.find((x) => x.id === id);
      if (!item) return;
      editingTasteId = id;
      document.getElementById('tasteModalTitle').textContent = `${item.label} · ${tastePerson}`;
      document.getElementById('tasteModalValue').value = item.value || '';
      document.getElementById('tasteModal').classList.remove('hidden');
    }

    function closeTasteModal() {
      editingTasteId = null;
      document.getElementById('tasteModal').classList.add('hidden');
    }

    function saveTasteDetail(event) {
      event.preventDefault();
      if (!editingTasteId) return;
      const items = appState.tastes[tastePerson] || [];
      const item = items.find((x) => x.id === editingTasteId);
      if (item) {
        item.value = document.getElementById('tasteModalValue').value.trim();
        saveAppState();
        renderTastes();
      }
      closeTasteModal();
    }

    function exportDataBackup() {
      const dataStr = JSON.stringify(appState, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `nuestro-rincon-ruben-mar-${formatDateKey(new Date())}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function escapeAttr(str) {
      return String(str || '').replace(/"/g, '&quot;');
    }

    function restoreSavedSession() {
      try {
        const raw = localStorage.getItem(SESSION_KEY) || sessionStorage.getItem(SESSION_KEY);
        if (!raw) return false;
        const parsed = JSON.parse(raw);
        if (parsed && parsed.username && USERS[parsed.username]) {
          currentSession = USERS[parsed.username];
          enterApp();
          return true;
        }
      } catch (e) {}
      return false;
    }

    setInterval(updateCountdown, 1000);
    restoreSavedSession();
  </script>
</body>
</html>
